# 0 "arch/arm64/boot/dts/overlays/sixfab_m1m-overlay.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/overlays/sixfab_m1m-overlay.dts"

/dts-v1/;
/plugin/;
/ {
 compatible = "brcm,bcm2712";
 fragment@0 {
  target = <&pciex1>;
  __overlay__ {
   status = "okay";
   max-link-speed = <3>;
  };
 };
};
